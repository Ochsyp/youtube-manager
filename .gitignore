# Secrets and Compose's .env (README.md, Configuration and Deploying).
.env*

# Runtime state a run from this checkout can leave in the tree: the SQLite
# database in data/.
/data/*
!/data/.gitkeep
*.db
*.db-*
*.sqlite*

# Python bytecode and local environments.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Logs.
*.log

# Editor and OS files.
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
desktop.ini
.DS_Store
