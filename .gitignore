# Secrets. .env.example documents every variable.
.env*
!.env.example

# Runtime state a run from this checkout can leave in the tree: the SQLite
# database in data/ and, with the checkout mounted at /app, yt-dlp's .cache/.
/data/*
!/data/.gitkeep
/.cache/
*.db
*.db-*
*.sqlite*

# Python bytecode and local environments.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Logs.
*.log

# Editor and OS files.
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
desktop.ini
.DS_Store
