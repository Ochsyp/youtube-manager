# The actions the standard's workflows may use, as GitHub's allow-list writes them;
# workflows.bats holds the workflows to it, and tools/status compares it with each repository's.
actions/checkout@*
actions/setup-python@*
actions/upload-artifact@*
actions/download-artifact@*
actions/attest@*
docker/setup-qemu-action@*
docker/setup-buildx-action@*
docker/build-push-action@*
