#!/bin/bash
# secret-scan of the repository standard: the same file in every repository; never edit it here.
# The job scan of secret-scan.yml. It works in this order and fails at the first
# problem:
# 1. Positive controls. In one scratch repository, gitleaks with the flags of the real scan must
#    find a token that this tool builds from fragments. In another, privacy-scan must find a
#    sample of every kind of every pack the config enables (conf --samples). Where GitHub's
#    secret scanning is off, this job is the only server-side scanner. The controls prove that it
#    still finds something.
# 2. The range. A pull request scans BASE..HEAD, and so does a push, with BASE as the push's
#    before. A schedule, a dispatch or a first push (an all-zero before) scans the whole history.
# 3. Accepted findings. Every .gitleaksignore line must read commit:file:rule:line. Its commit,
#    and the commit of every PRIVACY_HISTORY_ACCEPT record, must be an ancestor of BASE (of HEAD
#    for the whole history). So a pull request can accept only old findings, never its own.
# 4. The scans. gitleaks git --redact runs with its default rules only: .gitleaks.toml is refused,
#    and GITLEAKS_CONFIG and GITLEAKS_CONFIG_TOML are unset. It honours no inline allow markers
#    (--ignore-gitleaks-allow). Then privacy-scan --range or --history runs.
#    CI has no denylist, so only the packs run there; the sweep of repo-standard's tools/status,
#    run regularly, checks the denylist. The output holds counts, rule names, kinds and places,
#    never a value.
#   secret-scan          reads EVENT, BASE and HEAD
# Exit 0 clean; 1 a finding or a broken rule; 2 when a check cannot run; 64 usage.
set -euo pipefail
here=$(CDPATH='' cd -- "${BASH_SOURCE[0]%/*}" && pwd)
# shellcheck source=SCRIPTDIR/lib.bash
. "$here/lib.bash"

[[ $# -eq 0 ]] || { echo "usage: secret-scan (reads EVENT, BASE and HEAD)" >&2; exit 64; }
top=$(git rev-parse --show-toplevel 2> /dev/null) || { error "not in a git work tree"; exit 2; }
cd "$top"
unset GITLEAKS_CONFIG GITLEAKS_CONFIG_TOML
umask 077
tmp=$(mktemp -d "${TMPDIR:-/tmp}/secret-scan.XXXXXX") || { error "cannot create a temp folder"; exit 2; }
trap 'rm -rf -- "$tmp"' EXIT

# Run gitleaks with the flags of every run here: its default rules, values redacted, a JSON
# report, and inline allow markers ignored. A marker in any scanned commit would hide its line,
# and standard-check refuses the marker only in the tree, not in the history.
gitleaks_scan() {
    local repo=$1 report=$2
    shift 2
    gitleaks git "$repo" --redact --no-banner --ignore-gitleaks-allow --report-format json \
        --report-path "$report" "$@" > "$tmp/gitleaks.out" 2>&1
}

# The rule ids of a gitleaks JSON report, one per finding; nothing for a report without one.
rule_ids() {
    { grep -o '"RuleID": *"[^"]*"' "$1" || true; } | sed 's/.*"\([^"]*\)"$/\1/'
}

# Make $1 a scratch repository that no global or system git config reaches; commit all of it
# with the message $2.
scratch_commit() {
    : > "$tmp/gitconfig"
    mkdir -p "$tmp/template"
    GIT_CONFIG_GLOBAL=$tmp/gitconfig GIT_CONFIG_NOSYSTEM=1 git -C "$1" init -q --template="$tmp/template"
    GIT_CONFIG_GLOBAL=$tmp/gitconfig GIT_CONFIG_NOSYSTEM=1 git -C "$1" add -A
    GIT_CONFIG_GLOBAL=$tmp/gitconfig GIT_CONFIG_NOSYSTEM=1 git -C "$1" -c user.name=secret-scan \
        -c user.email=secret-scan@example.invalid commit -q -m "$2"
}

[[ ! -e .gitleaks.toml ]] ||
    die ".gitleaks.toml is refused: it can drop gitleaks' default rules and allow away any finding (rule 8 in .github/standard/README.md)"

zero=0000000000000000000000000000000000000000
event=${EVENT:-}
base=${BASE:-}
head=${HEAD:-HEAD}
full=0
case $event in
    pull_request)
        [[ -n $base ]] || { error "a pull request needs BASE, its base commit"; exit 2; }
        ;;
    push) [[ -n $base && $base != "$zero" ]] || full=1 ;;
    *) full=1 ;;
esac
if (( full )); then anchor=$head; else anchor=$base; fi
git cat-file -e "$anchor^{commit}" 2> /dev/null || { error "no commit $anchor in this clone"; exit 2; }

# 1. The positive controls.
mkdir -p "$tmp/control"
printf 'token = %s%s_%s\n' gh p "$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 36)" \
    > "$tmp/control/settings.ini"
scratch_commit "$tmp/control" "chore: the control"
gitleaks_scan "$tmp/control" "$tmp/control.json" || true
[[ -s $tmp/control.json && -n $(rule_ids "$tmp/control.json") ]] ||
    die "the gitleaks control found nothing, so gitleaks would miss a committed token"
rules=$(sh "$here/conf" --get PRIVACY_RULES .github/standard.conf) ||
    { error "cannot read PRIVACY_RULES from .github/standard.conf"; exit 2; }
if [[ -n $rules ]]; then
    mkdir -p "$tmp/privacy/.github/standard/bin" "$tmp/privacy/samples"
    cp -R .githooks "$tmp/privacy/.githooks"
    cp "$here/conf" "$tmp/privacy/.github/standard/bin/conf"
    printf 'NAME=control\nVISIBILITY=public\nRELEASE_KIND=tar\nPRIVACY_RULES=%s\n' "$rules" \
        > "$tmp/privacy/.github/standard.conf"
    kinds=()
    for pack in $rules; do
        while IFS= read -r kind; do
            kinds+=("$kind")
        done < <(awk -F '|' '!/^[ \t]*(#|$)/ { print $1 }' ".githooks/rules/$pack")
    done
    for kind in "${kinds[@]}"; do
        sh "$here/conf" --samples "$kind" > "$tmp/privacy/samples/$kind.txt" 2> /dev/null ||
            die "the privacy control has no sample of the kind $kind (conf --samples)"
    done
    scratch_commit "$tmp/privacy" "chore: the control"
    (cd "$tmp/privacy" && sh .githooks/privacy-scan --range HEAD) < /dev/null > /dev/null \
        2> "$tmp/privacy.out" || true
    for kind in "${kinds[@]}"; do
        grep -q -e ": $kind\$" "$tmp/privacy.out" ||
            die "the privacy control found no $kind, so the packs would miss it"
    done
fi

# 3. Accepted findings name old commits only.
problems=0
if [[ -f .gitleaksignore ]]; then
    n=0
    while IFS= read -r line || [[ -n $line ]]; do
        n=$((n + 1))
        [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
        if [[ ! $line =~ ^([0-9a-f]{40}):.+:[A-Za-z0-9._-]+:[0-9]+$ ]]; then
            error ".gitleaksignore:$n: not commit:file:rule:line; without its commit a line accepts a finding in every commit"
            problems=$((problems + 1))
        elif ! git merge-base --is-ancestor "${BASH_REMATCH[1]}" "$anchor" 2> /dev/null; then
            error ".gitleaksignore:$n: its commit is not an ancestor of the base, so it would accept a new finding"
            problems=$((problems + 1))
        fi
    done < .gitleaksignore
fi
n=0
while read -r sha _; do
    [[ -n $sha ]] || continue
    n=$((n + 1))
    if ! git merge-base --is-ancestor "$sha" "$anchor" 2> /dev/null; then
        error "PRIVACY_HISTORY_ACCEPT entry $n: its commit is not an ancestor of the base, so it would accept a new finding"
        problems=$((problems + 1))
    fi
done < <(sh "$here/conf" --get PRIVACY_HISTORY_ACCEPT .github/standard.conf 2> /dev/null || true)
(( problems == 0 )) || exit 1

# 4. The scans.
status=0
opts=()
(( full )) || opts=("--log-opts=$base..$head")
gitleaks_scan . "$tmp/scan.json" "${opts[@]}" || true
[[ -s $tmp/scan.json ]] || { error "gitleaks wrote no report"; cat "$tmp/gitleaks.out" >&2; exit 2; }
rule_ids "$tmp/scan.json" | sort | uniq -c | sort -k 1,1nr -k 2,2 > "$tmp/counts"
if [[ -s $tmp/counts ]]; then
    error "gitleaks found $(awk '{ n += $1 } END { print n }' "$tmp/counts") finding(s):" \
        "$(awk '{ printf "%s%s (%d)", (NR > 1 ? ", " : ""), $2, $1 }' "$tmp/counts")"
    status=1
else
    say "gitleaks found nothing"
fi
scan=0
if (( full )); then
    sh .githooks/privacy-scan --history < /dev/null || scan=$?
else
    sh .githooks/privacy-scan --range "$base..$head" < /dev/null || scan=$?
fi
case $scan in
    0) ;;
    1) status=1 ;;
    *) exit 2 ;;
esac
exit "$status"
